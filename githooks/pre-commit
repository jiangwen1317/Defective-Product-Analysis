#!/bin/sh
# pre-commit：提交前机械触发点（AGENTS.md 第十三节）
# 强制运行仓库根 check.bat，五步检查任一失败即拦截提交。
# 启用方式（一次性，在仓库根执行）：git config core.hooksPath githooks
# 每次执行追加审计记录到 .git/check-audit.log（时间、HEAD、退出码）。

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

# MSYS 会把单斜杠参数 /c 转换为 C:/ 路径，必须用 //c 转义
cmd.exe //c check.bat
status=$?

git_dir=$(git rev-parse --git-dir)
head_rev=$(git rev-parse --short HEAD 2>/dev/null || echo none)
printf '%s\thead=%s\texit=%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$head_rev" "$status" \
    >> "$git_dir/check-audit.log"

if [ "$status" -ne 0 ]; then
    echo "pre-commit: check.bat 未通过（退出码 $status），提交已被拦截。" >&2
    exit "$status"
fi
exit 0
